<Window x:Class="WpfAppXGCommLib.ElevatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elevator Monitor" Height="600" Width="400" Background="#222222">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Black" CornerRadius="5" Padding="20" BorderBrush="#444" BorderThickness="2">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="FLOOR" Foreground="#888" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                <Grid>
                    <TextBlock x:Name="Txt_Floor" Text="1" Foreground="Red" FontSize="80" FontWeight="Bold" 
                               HorizontalAlignment="Center" FontFamily="Consolas">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Red" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Path x:Name="Path_Up" Data="M 0 15 L 15 0 L 30 15" Stroke="DimGray" StrokeThickness="4" Margin="10,0"/>
                    <Path x:Name="Path_Down" Data="M 0 0 L 15 15 L 30 0" Stroke="DimGray" StrokeThickness="4" Margin="10,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,20" BorderBrush="#666" BorderThickness="4" Background="#111">
            <Grid x:Name="Grid_ElevatorShaft">
                <Rectangle Fill="#333" Margin="5"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="Door_Left" Width="80" Height="250" Background="#A0A0A0" BorderBrush="#555" BorderThickness="1" Margin="1,0">
                        <Rectangle Width="2" Fill="#777" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    </Border>
                    <Border x:Name="Door_Right" Width="80" Height="250" Background="#A0A0A0" BorderBrush="#555" BorderThickness="1" Margin="1,0">
                        <Rectangle Width="2" Fill="#777" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <GroupBox Grid.Row="2" Header="Manual Control" Foreground="White" Padding="10">
            <StackPanel>
                <UniformGrid Columns="2" Height="50">
                    <Button x:Name="Btn_2F" Content="2F" Margin="5" FontSize="18" FontWeight="Bold" 
                            Background="#444" Foreground="White"/>
                    <Button x:Name="Btn_1F" Content="1F" Margin="5" FontSize="18" FontWeight="Bold" 
                            Background="#444" Foreground="White"/>
                </UniformGrid>
                <TextBlock x:Name="Txt_Status" Text="Status: Connected" Foreground="LimeGreen" 
                           HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>