<Window x:Class="WpfAppPLC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elevator HMI (XGCommLib)"
        Width="1421" Height="852"
        MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F7">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" Color="#22000000" ShadowDepth="2" BlurRadius="14" Opacity="0.18"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF111827"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF111827"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF6B7280"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF111827"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
        </Style>

        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF111827"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="28"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDE ================= -->
        <StackPanel Grid.Column="0" Orientation="Vertical">

            <!-- Connection -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="연결" Style="{StaticResource H2}" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="IP" Width="28" VerticalAlignment="Center"/>
                        <TextBox x:Name="TextBox_IP"
                                 Grid.Column="1"
                                 Height="30"
                                 Text="127.0.0.1"
                                 BorderBrush="#FFE5E7EB"
                                 BorderThickness="1"
                                 Padding="8,4"/>

                        <TextBlock Grid.Column="2"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Port" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TextBox_Port"
                                     Width="80"
                                     Height="30"
                                     Text="2004"
                                     BorderBrush="#FFE5E7EB"
                                     BorderThickness="1"
                                     Padding="8,4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ButtonConnect"
                                Content="Connect"
                                Style="{StaticResource PrimaryButton}"
                                Click="Button_Connect_Click"/>
                        <Button x:Name="ButtonDisconnect"
                                Content="Disconnect"
                                Style="{StaticResource OutlineButton}"
                                Click="Button_Disconnect_Click"
                                IsEnabled="False"
                                Margin="0,0,8,0"/>
                        <TextBlock x:Name="Text_ConnState"
                                   VerticalAlignment="Center"
                                   Text="Disconnected"
                                   Foreground="Crimson"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <TextBlock Text="연결 후 PLC(%MX/%MB) 상태를 주기적으로 읽어서 시각화를 갱신합니다."
                               Style="{StaticResource Muted}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="상태" Style="{StaticResource H2}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="현재층:" Width="64"/>
                                <TextBlock x:Name="Text_CurrentFloor" Text="-" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="이동:" Width="64"/>
                                <TextBlock x:Name="Text_Moving" Text="-" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="문:" Width="64"/>
                                <TextBlock x:Name="Text_Door" Text="-" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- 이벤트 코드 표시 -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="코드:" Width="64"/>
                                <TextBlock x:Name="TextEventCode" Text="-" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse x:Name="Lamp_Moving" Width="14" Height="14" Fill="#FFE2E8F0" Margin="0,2,8,0"/>
                                <TextBlock Text="Moving" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Lamp_Door" Width="14" Height="14" Fill="#FFE2E8F0" Margin="0,2,8,0"/>
                                <TextBlock Text="Door" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="Text_LastCmd" Text="마지막 이벤트(MB100): -" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Inside panel -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="내부 패널" Style="{StaticResource H2}" Margin="0,0,0,10"/>

                    <TextBlock Text="층 선택" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button x:Name="Btn_In_Floor1"
                                Content="1"
                                Style="{StaticResource CircleButton}"
                                Click="Button_Floor1_Click"
                                Margin="0,0,10,0"/>
                        <Button x:Name="Btn_In_Floor2"
                                Content="2"
                                Style="{StaticResource CircleButton}"
                                Click="Button_Floor2_Click"/>
                    </StackPanel>

                    <TextBlock Text="도어" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="Btn_DoorOpen"
                                Grid.Column="0"
                                Content="문 열기"
                                Style="{StaticResource OutlineButton}"
                                Click="Button_DoorOpen_Click"
                                Margin="0"/>
                        <Button x:Name="Btn_DoorClose"
                                Grid.Column="2"
                                Content="문 닫기"
                                Style="{StaticResource OutlineButton}"
                                Click="Button_DoorClose_Click"
                                Margin="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Outside panel -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="외부 호출" Style="{StaticResource H2}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1F -->
                        <Border Grid.Row="0"
                                Background="#FFF9FAFB"
                                BorderBrush="#FFE5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="1F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="호출" Style="{StaticResource Muted}" VerticalAlignment="Center"/>

                                <Button x:Name="Btn_Out_F1_Up"
                                        Grid.Column="2"
                                        Content="▲"
                                        Width="48"
                                        Height="44"
                                        Style="{StaticResource OutlineButton}"
                                        Click="Button_Up1F_Click"
                                        Margin="0"/>

                                <!-- 1층 Down은 일반적으로 사용 안 함(필요하면 비트 추가해서 활성화 가능) -->
                                <Button x:Name="Btn_Out_F1_Down"
                                        Grid.Column="4"
                                        Content="▼"
                                        Width="48"
                                        Height="44"
                                        Style="{StaticResource OutlineButton}"
                                        IsEnabled="False"
                                        Margin="0"/>
                            </Grid>
                        </Border>

                        <!-- 2F -->
                        <Border Grid.Row="2"
                                Background="#FFF9FAFB"
                                BorderBrush="#FFE5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="2F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="호출" Style="{StaticResource Muted}" VerticalAlignment="Center"/>

                                <!-- 2층 Up은 일반적으로 사용 안 함(필요하면 비트 추가해서 활성화 가능) -->
                                <Button x:Name="Btn_Out_F2_Up"
                                        Grid.Column="2"
                                        Content="▲"
                                        Width="48"
                                        Height="44"
                                        Style="{StaticResource OutlineButton}"
                                        IsEnabled="False"
                                        Margin="0"/>

                                <Button x:Name="Btn_Out_F2_Down"
                                        Grid.Column="4"
                                        Content="▼"
                                        Width="48"
                                        Height="44"
                                        Style="{StaticResource OutlineButton}"
                                        Click="Button_Down2F_Click"
                                        Margin="0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="외부 Up/Down 버튼은 로직상 MX18(Up), MX19(Down)으로 입력됩니다."
                               Style="{StaticResource Muted}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================= RIGHT SIDE ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- Visualization -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="엘리베이터 동작 시각화" Style="{StaticResource H1}"/>

                    <Viewbox Grid.Row="1"
                             Margin="0,12,0,0"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Grid Width="980" Height="560">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Stretch">
                                <TextBlock Text="2F" Margin="0,86,0,0" FontWeight="SemiBold" Foreground="#FF374151"/>
                                <TextBlock Text="1F" Margin="0,472,0,0" FontWeight="SemiBold" Foreground="#FF374151"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#FFF9FAFB"
                                    BorderBrush="#FFE5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="18">

                                <Canvas x:Name="ShaftCanvas" Width="860" Height="520">
                                    <!-- floor lines -->
                                    <Line X1="0" Y1="100" X2="860" Y2="100" Stroke="#FFD1D5DB" StrokeThickness="2"/>
                                    <Line X1="0" Y1="480" X2="860" Y2="480" Stroke="#FFD1D5DB" StrokeThickness="2"/>

                                    <!-- rails -->
                                    <Line X1="260" Y1="10" X2="260" Y2="510" Stroke="#FFCBD5E1" StrokeThickness="6"/>
                                    <Line X1="560" Y1="10" X2="560" Y2="510" Stroke="#FFCBD5E1" StrokeThickness="6"/>

                                    <!-- CAR -->
                                    <Grid x:Name="CarRoot"
                                          Width="240"
                                          Height="160"
                                          Canvas.Left="290"
                                          Canvas.Top="310">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="CarTranslate" Y="0"/>
                                        </Grid.RenderTransform>

                                        <Border CornerRadius="16"
                                                Background="White"
                                                BorderBrush="#FFE5E7EB"
                                                BorderThickness="1"
                                                Effect="{StaticResource CardShadow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock x:Name="Text_CarFloor"
                                                           Text="-"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,10,0,6"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FF111827"/>

                                                <Grid Grid.Row="1" Margin="18,0,18,0">
                                                    <Border Background="#FFF3F4F6" CornerRadius="10" BorderBrush="#FFE5E7EB" BorderThickness="1"/>

                                                    <Border x:Name="DoorLeft"
                                                            Background="#FFE5E7EB"
                                                            CornerRadius="8"
                                                            Margin="6"
                                                            HorizontalAlignment="Left"
                                                            Width="92">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="DoorLeftTransform" X="0"/>
                                                        </Border.RenderTransform>
                                                    </Border>

                                                    <Border x:Name="DoorRight"
                                                            Background="#FFE5E7EB"
                                                            CornerRadius="8"
                                                            Margin="6"
                                                            HorizontalAlignment="Right"
                                                            Width="92">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="DoorRightTransform" X="0"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Grid.Row="2"
                                                           Text="CAR"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,6,0,10"
                                                           Foreground="#FF6B7280"
                                                           FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Canvas>
                            </Border>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="로그" Style="{StaticResource H2}" />
                        <Button Grid.Column="1"
                                x:Name="ButtonClearLog"
                                Content="Clear Log"
                                Style="{StaticResource OutlineButton}"
                                Click="Button_ClearLog_Click"
                                Margin="0"/>
                    </Grid>

                    <TextBox x:Name="TextBox_Log"
                             Grid.Row="1"
                             FontFamily="Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             BorderBrush="#FFE5E7EB"
                             BorderThickness="1"
                             Padding="10"
                             Background="#FFFBFBFB"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
